###############################################################################
# auth-server — complete environment template.
#
# apply-envs style rule: this file is the whole contract. A parameter added by
# hand to a running deployment and not written here is a parameter that will
# disappear at the next regeneration.
#
# Phase markers tell you when a parameter starts being read:
#   [phase 1] read now       [phase 3] Kerberos/LDAP    [phase 4] SQL group check
#   [phase 4-bis] optional fallback form + optional TOTP second factor
#                                                       (all of them are live)
###############################################################################

# --- Public identity -------------------------------------------------------

# [phase 1] REQUIRED. The single source of the public name: it is the `issuer`
# in the discovery document and the base of every published endpoint. It must be
# the name nginx serves, never the container hostname, and it must NOT end in a
# trailing slash. The Kerberos SPN is derived from its hostname.
ISSUER_URL=http://127.0.0.1:3000

# [phase 1] TCP port and bind address of the Node process (nginx proxies to it).
PORT=3000
HOST=0.0.0.0

# [phase 1] Turn on behind the TLS-terminating nginx, so the request is seen as
# https and the session cookies get the Secure flag. The issuer is still taken
# from ISSUER_URL, never rebuilt from the request headers.
TRUST_PROXY=false

# [phase 1] pino level: trace|debug|info|warn|error|fatal.
LOG_LEVEL=info

# --- Storage ---------------------------------------------------------------

# [phase 1] MongoDB holding grants, sessions, codes and tokens, plus the signing
# key. Leave it empty and the server falls back to an in-memory store: fine for
# development, useless in production — a restart drops every token.
MONGO_URL=mongodb://127.0.0.1:27017/auth-server

# [phase 1] Only needed when the database name is not in MONGO_URL's path.
#MONGO_DB_NAME=auth-server

# [phase 1] Where the RS256 signing key is persisted when MONGO_URL is empty.
# Mount it as a volume so `docker compose down/up` does not invalidate tokens.
# Set it to the empty string to keep the key in memory (tests only).
DATA_DIR=./data

# --- Identity provider -----------------------------------------------------

# [phase 1] dev-stub | spnego | database
#   dev-stub : fixed users from DEV_STUB_USERS, plain login form. Development.
#   spnego   : Kerberos/SPNEGO SSO against Active Directory, with an LDAP
#              simple-bind password form for machines outside the domain.
#              Requires REALM, LDAP_URL, LDAP_BIND_DN, LDAP_BIND_PASSWORD and
#              LDAP_BASE_DN; the server refuses to start without them.
#   database : username/password form verified against a customer database —
#              SQL (shared SQL_DRIVER/SQL_CONNECTION_STRING pool) or an
#              external MongoDB. No SSO. Requires AUTH_DB_SOURCE and the
#              parameters of the chosen source; see the AUTH_* section below.
IDENTITY_PROVIDER=dev-stub

# [phase 1] Users for the dev-stub provider. `active:false` makes isAccountActive
# reject, which is how the refresh-time enforcement is exercised without an AD.
DEV_STUB_USERS=[{"username":"mario.rossi","password":"Password1!","active":true},{"username":"luigi.verdi","password":"Password2!","active":true}]

# [phase 1] Realm appended to dev-stub usernames so the principal keeps the AD
# shape (user@REALM).
DEV_STUB_REALM=DEV.LOCAL

# [phase 1/3] Kerberos realm of the deployment, uppercase. It is the `realm`
# claim in the tokens. Required when IDENTITY_PROVIDER=spnego; with dev-stub it
# defaults to DEV_STUB_REALM.
#REALM=LAB.EASYOIDC.LOCAL

# --- Kerberos (read when IDENTITY_PROVIDER=spnego) -------------------------

# [phase 3] Service keytab holding HTTP/<public name>@<REALM>. Mount it
# read-only, never bake it into the image. The native krb5 library reads this
# very variable, so it is exported to the process environment as well.
# Unset => the krb5 default, /etc/krb5.keytab.
#KRB5_KTNAME=/secrets/auth.keytab

# [phase 3] Expected SPN. Derived from ISSUER_URL's hostname when unset
# (HTTP/<hostname>); set it explicitly only when the public name and the SPN
# legitimately differ. Both spellings are accepted — HTTP/host and HTTP@host —
# and are normalised to the GSSAPI host-based form before the handshake.
#KERBEROS_SERVICE_NAME=HTTP/auth.lab.easyoidc.local

# --- LDAP account liveness (read when IDENTITY_PROVIDER=spnego) ------------

# [phase 3] REQUIRED with spnego. LDAPS only in production: the password
# fallback sends the user's own password over this connection.
# The liveness checks are: ACCOUNTDISABLE bit (2) of userAccountControl off, and
# accountExpires absent/0/in the future.
# Unreachable LDAP means REJECT, at login and at refresh alike. Never fail open —
# but a refresh refused for unavailability does NOT revoke the grant chain,
# while a refresh refused because the account is disabled does.
#LDAP_URL=ldaps://dc1.lab.easyoidc.local:636

# [phase 3] REQUIRED with spnego. Service account used for the liveness search.
# The UPN form (svc-auth@REALM) works without knowing the account's DN.
#LDAP_BIND_DN=svc-auth@LAB.EASYOIDC.LOCAL
#LDAP_BIND_PASSWORD=

# [phase 3] REQUIRED with spnego. Search base for the account lookup.
#LDAP_BASE_DN=DC=lab,DC=easyoidc,DC=local

# [phase 3] Optional AD group the account must belong to, as a full DN. Empty =
# no group requirement (the default). Direct membership only: nested groups are
# not walked, so name the group the users actually sit in.
#LDAP_REQUIRED_GROUP=CN=easyoidc-users,CN=Users,DC=lab,DC=easyoidc,DC=local

# [phase 3] Deadlines in milliseconds. Short on purpose: these run inside a
# login and inside every token refresh, and a slow "no" is still a "no".
LDAP_TIMEOUT_MS=5000
LDAP_CONNECT_TIMEOUT_MS=5000

# [phase 3] PEM bundle that signs the domain controllers' LDAPS certificate.
# Unset => the system trust store.
#LDAP_TLS_CA_FILE=/secrets/domain-ca.pem

# [phase 3] Overrides the hostname checked inside the certificate (SNI). Needed
# only when LDAP_URL points at an address the certificate does not name.
#LDAP_TLS_SERVERNAME=dc1.lab.easyoidc.local

# [phase 3] LABORATORY ONLY. Skips verification of the directory certificate,
# which is what the Samba lab's self-signed certificate needs. It is logged as a
# warning at every startup. In production use LDAP_TLS_CA_FILE instead.
LDAP_TLS_INSECURE=false

# --- Database identity provider (read when IDENTITY_PROVIDER=database) -----

# Where the credentials live: sql | mongo.
#   sql   : rides on the shared SQL_DRIVER / SQL_CONNECTION_STRING pool below —
#           the same one the group check, the TOTP seed and the extra claims
#           use. Requires AUTH_SQL_QUERY.
#   mongo : an EXTERNAL MongoDB (the customer's user store), NOT this server's
#           own MONGO_URL. Requires AUTH_MONGO_URL and AUTH_MONGO_COLLECTION.
#AUTH_DB_SOURCE=sql

# How the stored password is verified:
#   auto (default) — recognizes only the self-describing formats: bcrypt
#                    ($2a/$2b/$2y), argon2id, scrypt (PHC), pbkdf2 (Django);
#   sha256|sha1|md5 — bare hex digests, optionally salted (see the query
#                    contract below); ambiguous, so they must be declared;
#   plain          — clear text. Works, warns loudly at startup, and is a
#                    temporary state by definition.
#AUTH_PASSWORD_SCHEME=auto

# Credential query (AUTH_DB_SOURCE=sql). Same rules as every customer query
# here: exactly ONE bind placeholder, the username always bound. The FIRST
# column of the single row is the password hash; optional extra columns BY
# NAME: `salt` (digest schemes), `totpsecret` (seed for TWO_FACTOR_SOURCE=sql
# pointing at the same table). ZERO ROWS = unknown OR disabled user: the query
# is the activation policy, put the WHERE there.
#AUTH_SQL_QUERY=SELECT passwordhash, salt FROM users WHERE username = ? AND active = 1

# Connection and shape (AUTH_DB_SOURCE=mongo). The db name can live in the URL
# path; AUTH_MONGO_DB overrides it. Username matching is EXACT on the
# lowercased username. With AUTH_MONGO_ACTIVE_FIELD set, only a field equal to
# EXACTLY true reads as active; unset, an existing user is active.
#AUTH_MONGO_URL=mongodb://users.customer.local:27017/customers
#AUTH_MONGO_DB=customers
#AUTH_MONGO_COLLECTION=users
#AUTH_MONGO_USERNAME_FIELD=username
#AUTH_MONGO_PASSWORD_FIELD=password
#AUTH_MONGO_ACTIVE_FIELD=enabled
#AUTH_MONGO_SALT_FIELD=salt
# Enables TWO_FACTOR_SOURCE=mongo: the TOTP seed read from the same document.
#AUTH_MONGO_TOTP_FIELD=totpsecret

# --- Optional SQL group check (phase 4, live) ------------------------------

# [phase 4] Second authorization gate against a database that is NOT Active
# Directory — typically the customer's back office. It runs after the account
# liveness check, at login AND at every refresh.
#
# With the switch off nothing here is constructed: no checker, no pool, and the
# database library is never even loaded. The other SQL_* parameters are then
# ignored, and may stay empty.
SQL_GROUP_CHECK_ENABLED=false

# [phase 4] Engine. mysql | mssql
#   mysql : mysql2 — MySQL and MariaDB. This is what the current customer runs.
#   mssql : tedious — Microsoft SQL Server.
SQL_DRIVER=mysql

# [phase 4] REQUIRED when the check is on. mysql2 takes a URL; mssql takes
# either a URL or the classic ADO string
# (Server=db.internal;Database=backoffice;User Id=…;Password=…).
#SQL_CONNECTION_STRING=mysql://user:password@db.internal:3306/backoffice
#SQL_CONNECTION_STRING=mssql://user:password@db.internal:1433/backoffice

# [phase 4] REQUIRED when the check is on. The query the CUSTOMER supplies.
#
# The code assumes exactly two things about it and nothing more:
#   1. it takes ONE bound parameter, the platform username
#      (sAMAccountName lowercased — the same string as the `sub` claim);
#   2. at least one row returned = authorized, zero rows = not authorized.
# No column names, no result shape, no schema. It must be a SELECT.
#
# PLACEHOLDER CONVENTION — the query must contain EXACTLY ONE occurrence of the
# placeholder its engine binds by:
#     mysql : ?           SELECT 1 FROM authorized_users WHERE username = ?
#     mssql : @username   SELECT 1 FROM authorized_users WHERE username = @username
# Zero occurrences means the username would not be bound at all; more than one
# means the binding would be ambiguous. Either one stops the server at startup,
# by parameter name. The username is ALWAYS bound, never interpolated into the
# text — that is not configurable.
#SQL_GROUP_QUERY=SELECT 1 FROM authorized_users WHERE username = ?

# [phase 4] Deadline for connect + query, milliseconds. Short on purpose: this
# runs inside a login and inside every refresh, so the deadline is what stops a
# hung database from hanging the whole floor. Timing out is a REJECTION
# (temporarily_unavailable), never a pass — the grant chain is left intact
# because an outage of ours must not log everybody out for good.
SQL_TIMEOUT_MS=5000

# Periodic SELECT 1 (every 45 s) on the shared pool, when any SQL feature is
# on. Keeps the path warm through stateful firewalls that silently drop idle
# flows, and turns a broken path into a timestamped log line instead of a
# rejected login. Only transitions are logged. Off only for debugging.
SQL_KEEPALIVE_ENABLED=true

# --- Fallback form and second factor (phase 4-bis, live) -------------------

# [phase 4-bis] The credential form served inside the 401 challenge.
#
#   true  (default) : the 401 carries `WWW-Authenticate: Negotiate` AND the form.
#                     A domain-joined browser answers the header and signs in
#                     silently; everybody else types domain credentials.
#   false           : SSO ONLY. The 401 carries the Negotiate header and an
#                     explanatory page with NO form, and POSTs to
#                     /interaction/:uid/login are refused with 403 and a loud
#                     log (`fallback_form_disabled`). A machine outside the
#                     domain then has no way in at all — that is the point.
#
# Only meaningful with IDENTITY_PROVIDER=spnego. With dev-stub the form is the
# only door, so FALLBACK_FORM_ENABLED=false is refused at startup by name.
FALLBACK_FORM_ENABLED=true

# [phase 4-bis] TOTP second factor, ON THE FORM PATH ONLY.
#
# The Kerberos SSO path never asks for a code, by decision: a domain-joined
# machine has already proved possession of the user's credentials to the KDC,
# while the password form is the door a stolen password opens.
#
# On: the form grows a "Codice di verifica" field (POST field name `otp`) and
# the code is verified as RFC 6238 TOTP — 6 digits, 30-second step, tolerance
# ±1 step. None of those three is configurable.
#
# A code already accepted for a user is refused if it is presented again (the
# last accepted time step is remembered per user). THAT MEMORY IS IN THIS
# PROCESS: the replay table and the failed-attempt counters below assume a
# SINGLE auth-server instance, which is what the compose of phase 5 deploys.
# Two replicas would each keep their own tables.
TWO_FACTOR_ENABLED=false

# [phase 4-bis] REQUIRED when the second factor is on. sql | ldap | mongo
# Where the per-user seed ("master key", a base32 TOTP secret) is READ from.
# `mongo` is only available with IDENTITY_PROVIDER=database and
# AUTH_DB_SOURCE=mongo: the seed comes from the same credential document, in
# the field AUTH_MONGO_TOTP_FIELD names.
# This server never generates and never writes a seed: enrolment belongs to
# whoever owns the source. A user with no seed is REFUSED while the switch is on
# (fail closed, log reason `two_factor_not_enrolled`); a source that cannot
# answer is also a refusal (`temporarily_unavailable`), never a pass.
#
# The seed must be at least 80 bits of base32 (16 base32 characters) — the
# legacy Google-Authenticator format the customer's installed base carries
# (TWO_FACTOR_MIN_SECRET_BYTES in src/twofactor/verifier.ts). RFC 4226 §4 asks
# for 128 bits and recommends 160 (32 characters): issue NEW enrolments at that
# size. A shorter or malformed seed is refused as an unusable enrolment and
# logged as `two_factor_seed_invalid`.
#TWO_FACTOR_SOURCE=sql

# [phase 4-bis] REQUIRED when TWO_FACTOR_SOURCE=sql. Same contract as
# SQL_GROUP_QUERY — exactly ONE bind placeholder for the username (`?` mysql,
# `@username` mssql), the username always bound and never interpolated — plus
# one more rule: the seed is the FIRST COLUMN OF THE FIRST ROW. Zero rows means
# the user is not enrolled; a NULL or empty value reads the same way.
#
# It uses SQL_DRIVER and SQL_CONNECTION_STRING above, which therefore become
# REQUIRED even when SQL_GROUP_CHECK_ENABLED=false. When both features are on
# they share one connection pool; either works with the other disabled.
#TWO_FACTOR_SQL_QUERY=SELECT seed FROM totp_seeds WHERE username = ?

# [phase 4-bis] REQUIRED when TWO_FACTOR_SOURCE=ldap. The attribute holding the
# seed on the user's directory record, read with the SAME service bind as the
# account liveness check (LDAP_BIND_DN). Requires IDENTITY_PROVIDER=spnego.
# Use an attribute your schema already has and nothing else uses — do not
# redefine the AD schema for this.
#TWO_FACTOR_LDAP_ATTRIBUTE=pager

# [phase 4-bis] Cool-down on FAILED FORM ATTEMPTS, per user name. It counts a
# wrong password and a wrong verification code alike; the Kerberos path is never
# counted. When the count is reached, further form attempts for that name are
# refused for FORM_LOCKOUT_SECONDS with an Italian "troppi tentativi" message
# and a `login_rate_limited` log line. A successful login clears the history.
#
# It never disables an account: Active Directory's own lockout policy is still
# the authority. Set FORM_MAX_FAILED_ATTEMPTS=0 to switch it off entirely.
# In-memory, therefore per instance — see the note under TWO_FACTOR_ENABLED.
FORM_MAX_FAILED_ATTEMPTS=5
FORM_LOCKOUT_SECONDS=300

# --- Optional extra token claims from the customer database (phase 4-ter) ---

# [phase 4-ter] Extra claims read from the customer's back office and put into
# EVERY id token — and into every JWT access token when API_AUDIENCE is set.
#
# What it is for: Active Directory knows who the person is, it does NOT know who
# they are in the back office. The resource API receives a token and has to
# attribute the work without a second lookup, so the back-office identity rides
# in the token.
#
# BY SERVER POLICY, and this is not negotiable per client: the claims are
# included whatever `scope` was requested and whatever the `claims` request
# parameter says. A client can neither ask for them nor opt out. They also show
# up in `claims_supported` of the discovery document.
#
# Third feature on the SAME SQL connection as the group check and the TOTP seed:
# it uses SQL_DRIVER, SQL_CONNECTION_STRING and SQL_TIMEOUT_MS above, which
# therefore become REQUIRED even with the other two switched off — the features
# share the database, not each other's switch. With this switch off nothing is
# constructed: no source, no pool, and the database library is never loaded.
CLAIMS_SQL_ENABLED=false

# [phase 4-ter] REQUIRED when the claims are on. The query the CUSTOMER supplies,
# on ONE line.
#
# THE CONTRACT, in full:
#   1. exactly ONE bind placeholder for the username — `?` (mysql) or
#      `@username` (mssql), same rule and same startup validation as
#      SQL_GROUP_QUERY. The username is always BOUND, never interpolated;
#   2. EXACTLY ONE ROW is expected. Zero rows means the domain account is not
#      linked to any back-office user: the login is refused with an Italian page
#      and a refresh dies with invalid_grant AND the grant chain revoked
#      (reason `claims_user_not_found`). Two rows or more is a fault, not an
#      answer: temporarily_unavailable, chain intact;
#   3. THE COLUMN NAMES (the aliases) ARE THE CLAIM NAMES. No column name is
#      hardcoded anywhere in the server;
#   4. a NULL value OMITS that claim — not null, not an empty string: absent.
#
# NO COSMETICS ON THIS SIDE. Capitalisation, spacing and concatenation are the
# query's business (and the clients'); the server copies the values as they come.
#
# RESERVED CLAIM NAMES — an alias with one of these STOPS THE SERVER at startup,
# naming the claim:
#     sub  iss  aud  exp  nbf  iat  jti
#     auth_time  azp  client_id  scope  sid
#     realm  preferred_username
# `name` is allowed: it is a registered OIDC claim (Core §5.1, the user's full
# name in displayable form) and that is exactly the meaning below.
#
# EVERY COLUMN MUST BE NAMEABLE AT STARTUP. The SELECT list is parsed when the
# server boots, because oidc-provider freezes the set of emittable claim names
# when the provider is built: a name discovered later would be read, logged and
# then silently dropped from the token. So `SELECT *`, an unaliased expression,
# a duplicate alias or anything that is not a plain SELECT stop the boot, by
# parameter name. Give every computed column an explicit `AS <name>`; a bare
# `t.column` is fine and becomes the claim `column`.
#
# COST. Two queries per login (one to be able to refuse in Italian, one when the
# tokens are minted) and ONE per refresh — that is one query per user per hour
# with the default ACCESS_TOKEN_TTL — on the shared pool, inside SQL_TIMEOUT_MS.
#
# The reference query of the current customer, MySQL, on one line (`remoteId` is
# their user ID in the back office, `name` the displayable name they compose):
#CLAIMS_SQL_QUERY=SELECT ID AS remoteId, CONCAT_WS(' ', CONCAT(UPPER(LEFT(nome,1)),LOWER(SUBSTRING(nome,2))), CONCAT(UPPER(LEFT(cognome,1)),LOWER(SUBSTRING(cognome,2)))) AS name FROM users WHERE userid = ?

# --- Tokens ----------------------------------------------------------------

# [phase 1] Access token lifetime, seconds. Decided: 1 hour.
ACCESS_TOKEN_TTL=3600

# [phase 1] Refresh token lifetime, seconds. Decided: 12 hours. Rotation is
# always on: using a rotated-out refresh token revokes the whole chain.
REFRESH_TOKEN_TTL=43200

# [phase 1/7] Audience of the resource API. Set it and access tokens become
# RS256 JWTs the API can verify through the JWKS without calling back here.
# Leave it empty and access tokens stay opaque (the oidc-provider default).
#API_AUDIENCE=https://easyoidc.example.com/api

# --- Clients ---------------------------------------------------------------

# [phase 1] REQUIRED. JSON array of client registrations (oidc-provider client
# metadata). Defaults applied to each entry: application_type=native,
# token_endpoint_auth_method=none, grant_types=[authorization_code,refresh_token],
# response_types=[code], id_token_signed_response_alg=RS256.
#
# PKCE with S256 is mandatory and cannot be turned off.
#
# Redirect URIs: because application_type is `native`, a loopback URI matches on
# host and path with ANY port, as RFC 8252 requires of a desktop client. Register
# http://127.0.0.1/callback once and the desktop client may listen on any free port.
CLIENTS_JSON=[{"client_id":"desktop-app","redirect_uris":["http://127.0.0.1/callback"]}]
